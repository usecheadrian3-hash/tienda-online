# ============================================================
# TIENDA ONLINE — VARIABLES DE ENTORNO (COPIA A .env)
# ============================================================

# ---- App ----
FLASK_APP=run.py
FLASK_ENV=development
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ---- Base de datos MySQL ----
# Producción (Ubuntu) usa DB_DRIVER=mysql (por defecto).
# Desarrollo local SIN MySQL: usar DB_DRIVER=sqlite (solo pruebas, NO producción).
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=ecommerce
DB_PASSWORD=ecommerce
DB_NAME=ecommerce
DB_POOL_SIZE=10
DB_POOL_RECYCLE=1800

# ---- JWT / Sesiones ----
JWT_SECRET_KEY=change-me-to-another-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# ---- Admin inicial (se crea con seed) ----
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=Admin123!

# ---- Subida de imágenes ----
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=8

# ---- Pagos ----
PAYMENT_PROVIDER=test
# test | stripe | mercadopago

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Mercado Pago (soporta PSE, Bancolombia, tarjetas en Colombia)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SITE_ID=MLA
MERCADOPAGO_USE_SSL=true

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ---- Email (envío de comprobantes) ----
MAIL_ENABLED=false
MAIL_BACKEND=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@tienda.com
MAIL_FROM_NAME=Mi Tienda

# ---- Tienda / Configuración inicial (se importa con seed) ----
STORE_NAME=Tienda
STORE_TAGLINE=Productos seleccionados para ti
STORE_CURRENCY=COP
STORE_TAX_RATE=19
STORE_TAX_NAME=IVA
FREE_SHIPPING_THRESHOLD=300000
STORE_SUPPORT_EMAIL=soporte@tienda.com
STORE_SUPPORT_PHONE=+57 300 000 0000
STORE_ADDRESS=Calle 0 # 00-00, Bogotá, Colombia
STORE_COUNTRY=CO
